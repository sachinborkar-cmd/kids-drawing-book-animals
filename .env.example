# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS CONFIGURATION TEMPLATE
# Kids Drawing Book – Animals (3-Step Digital E-Book Selling Website)
#
# IMPORTANT: Never commit actual secret keys to source control.
# Copy this file to .dev.vars for local Wrangler development, or configure
# via the Cloudflare Dashboard / 'wrangler secret put' for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE PAGES FUNCTIONS: ENCRYPTED SECRETS
# Set via: npx wrangler secret put <VARIABLE_NAME>
# Or in Cloudflare Dashboard > Workers & Pages > Settings > Environment Variables
# ------------------------------------------------------------------------------

# Razorpay API Secret (From Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"

# Razorpay Webhook Secret (Configured in Razorpay Webhooks tab)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# AWS IAM Secret Access Key (Private key with s3:GetObject permission)
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"


# ------------------------------------------------------------------------------
# 2. CLOUDFLARE PAGES: PUBLIC & ENVIRONMENT VARIABLES
# Defined in wrangler.toml under [vars] or in Cloudflare Dashboard
# ------------------------------------------------------------------------------

# Razorpay Public Key ID (Safe for frontend exposure e.g. rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_placeholder"

# Product Selling Price in INR (Integer e.g. 149)
PRODUCT_PRICE="149"

# Product Currency (Strictly INR for Indian domestic Razorpay transactions)
PRODUCT_CURRENCY="INR"

# AWS Region where the private S3 bucket is located
AWS_REGION="ap-south-1"

# AWS IAM Access Key ID (Safe identifier for the service user)
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"

# AWS S3 Private Bucket Name
AWS_S3_BUCKET="inkframepress-private-ebooks-442189079113-ap-south-1-an"

# S3 Object Key for the e-book PDF file
S3_PDF_KEY="Kids_Drawing_Book_Animals_School_Edition.pdf"

# Signed Download URL Expiry Duration in Seconds (600 = 10 minutes)
DOWNLOAD_EXPIRY_SECONDS="600"

# Customer Support Contact Email
SUPPORT_EMAIL="trenzy.helpme@gmail.com"


# ------------------------------------------------------------------------------
# 3. CLOUDFLARE D1 DATABASE BINDING
# Configured in wrangler.toml under [[d1_databases]]
# ------------------------------------------------------------------------------
# Binding Name: DB
# Database Name: kids-drawing-book-db
# Database ID: Configured in wrangler.toml after running 'wrangler d1 create'
